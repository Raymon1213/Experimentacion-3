import random
import networkx as nx
import numpy as np
import matplotlib.pyplot as plt
import pandas as pd
from collections import deque

random.seed(0)
np.random.seed(0)

# ---------------------------
# Ejemplo: grafo de la diapositiva
# ---------------------------
def build_example_graph():
    G = nx.Graph()
    # nodos
    nodes = ['A','B','C','D','E','G']  # usa G en vez de 'F' para coincidir con tu diapo
    G.add_nodes_from(nodes)
    # aristas con peso (ajusta si quieres)
    edges = [
      ('A','B',2), ('A','C',1), ('A','D',3),
      ('B','D',1), ('B','E',3),
      ('C','D',1), ('C','G',1),
      ('D','E',2), ('D','G',1),
      ('G','E',1)
    ]
    for u,v,w in edges:
        G.add_edge(u,v,weight=w)
    return G

# ---------------------------
# Utilidades
# ---------------------------
def path_weight(G, path):
    return sum(G[u][v]['weight'] for u,v in zip(path, path[1:]))

def is_valid_path(G, path, start='A', end='E'):
    return path[0]==start and path[-1]==end and all(G.has_edge(u,v) for u,v in zip(path,path[1:])) and len(set(path))==len(path)

# ---------------------------
# Greedy 1: pick max-weight edge that doesn't create cycle (Kruskal-like but constrained A->E)
# We build a path from A attempting always to append best reachable edge (greedy local).
# This is a constructive heuristic adapted to A->E requirement.
# ---------------------------
def greedy_max_edge(G, start='A', end='E'):
    # simple constructive approach: from current node choose outgoing edge of max weight that does not revisit node
    cur = start
    visited = {cur}
    path = [cur]
    while cur != end:
        candidates = [(G[cur][nbr]['weight'], nbr) for nbr in G[cur] if nbr not in visited]
        # but ensure that from candidate there's still a path to end (connectivity check)
        valid_cands = []
        for w,nbr in candidates:
            # check connectivity from nbr to end without visiting visited
            try:
                exists = nx.has_path(G.subgraph(set(G.nodes()) - set(visited) | {nbr}), nbr, end)
            except Exception:
                exists = False
            if exists:
                valid_cands.append((w,nbr))
        if not valid_cands:
            break
        # pick max weight
        w,nxt = max(valid_cands, key=lambda x: (x[0], random.random()))
        path.append(nxt)
        visited.add(nxt)
        cur = nxt
    return path if cur==end else None

# ---------------------------
# Greedy 2: maximize reachable vertices (lookahead count)
# ---------------------------
def greedy_max_reachable(G, start='A', end='E'):
    cur = start
    visited = {cur}
    path = [cur]
    while cur != end:
        cands = [nbr for nbr in G[cur] if nbr not in visited]
        scored = []
        for nbr in cands:
            # count reachable nodes from nbr without using visited
            sub_nodes = set(G.nodes()) - visited | {nbr}
            try:
                reachable = nx.node_connected_component(G.subgraph(sub_nodes), nbr)
                score = len(reachable)
            except Exception:
                score = 0
            # only keep if end reachable
            if end in reachable:
                scored.append((score, nbr))
        if not scored:
            break
        # pick the candidate that maximizes reachable count
        _, nxt = max(scored, key=lambda x: (x[0], random.random()))
        path.append(nxt)
        visited.add(nxt)
        cur = nxt
    return path if cur==end else None

# ---------------------------
# Local Search: Eliminacion + Reconexión (single-node removal + greedy rebuild)
# - remove one internal node, then try to reconnect using BFS/greedy reconnection to reach E without revisiting.
# ---------------------------
def reconnection_after_removal(G, path, remove_idx):
    # remove internal node at remove_idx (1..len-2)
    if remove_idx<=0 or remove_idx>=len(path)-1:
        return None
    start_prefix = path[:remove_idx]   # includes node at index remove_idx-1
    suffix_start = path[remove_idx-1]  # node before removed node
    # try to find a path from suffix_start to E avoiding nodes in start_prefix
    forbidden = set(start_prefix)
    try:
        # use BFS in subgraph excluding forbidden except suffix_start
        sub_nodes = set(G.nodes()) - forbidden | {suffix_start}
        subG = G.subgraph(sub_nodes)
        target = 'E'
        if not nx.has_path(subG, suffix_start, target):
            return None
        new_suffix = nx.shortest_path(subG, suffix_start, target, weight=None)  # unweighted reconnection
        new_path = start_prefix + new_suffix[1:]  # avoid duplication of suffix_start
        # ensure no duplicate nodes
        if len(set(new_path)) != len(new_path):
            return None
        if is_valid_path(G, new_path):
            return new_path
        else:
            return None
    except Exception:
        return None

def local_search_elimination(G, init_path, max_no_improve=50):
    if init_path is None: 
        return None, 0
    best = init_path
    best_w = path_weight(G, best)
    no_improve = 0
    iterations = 0
    while no_improve < max_no_improve:
        iterations += 1
        # pick random internal node to remove
        if len(best) <= 3:  # nothing to remove
            break
        remove_idx = random.randint(1, len(best)-2)
        cand = reconnection_after_removal(G, best, remove_idx)
        if cand and is_valid_path(G,cand):
            w = path_weight(G, cand)
            if w > best_w:
                best = cand
                best_w = w
                no_improve = 0
            else:
                no_improve += 1
        else:
            no_improve += 1
    return best, iterations

# ---------------------------
# Search with Restarts
# ---------------------------
def search_with_restarts(G, init_method, restarts=10):
    # init_method: function G -> path
    best_overall = None
    best_w = -np.inf
    trace = []
    for r in range(restarts):
        init = init_method(G)
        if init is None:
            continue
        local_best, iters = local_search_elimination(G, init)
        if local_best:
            w = path_weight(G, local_best)
            trace.append(w)
            if w > best_w:
                best_w = w
                best_overall = local_best
    return best_overall, trace

# ---------------------------
# Run on example graph and print solutions
# ---------------------------
if __name__ == "__main__":
    G = build_example_graph()
    print("Nodes:", G.nodes())
    print("Edges with weights:")
    for u,v,data in G.edges(data=True):
        print(f" {u}-{v} : {data['weight']}")
    print("\n--- Example graph runs ---")
    g1 = greedy_max_edge(G)
    g2 = greedy_max_reachable(G)
    print("Greedy1 path:", g1, "weight:", path_weight(G,g1) if g1 else None)
    print("Greedy2 path:", g2, "weight:", path_weight(G,g2) if g2 else None)

    best1, trace1 = search_with_restarts(G, greedy_max_edge, restarts=10)
    best2, trace2 = search_with_restarts(G, greedy_max_reachable, restarts=10)
    print("\nGreedy1 + Local best:", best1, "weight:", path_weight(G,best1) if best1 else None)
    print("Greedy2 + Local best:", best2, "weight:", path_weight(G,best2) if best2 else None)

    # Print traces (improvement per restart)
    print("\nTrace Greedy1+Local:", trace1)
    print("Trace Greedy2+Local:", trace2)

    # Simple plot: boxplot of the traces (if multiple runs)
    plt.figure(figsize=(6,4))
    data = [trace1 if trace1 else [0], trace2 if trace2 else [0]]
    plt.boxplot(data, labels=['G1+Local','G2+Local'])
    plt.ylabel('Best path weight after local search (per restart)')
    plt.title('Example: comparison traces')
    plt.grid(True)
    plt.show()

    # Print the final solution paths (to include in report)
    def print_path_info(label, p):
        if p:
            print(f"{label}: {p}  weight={path_weight(G,p)}")
        else:
            print(f"{label}: None")

    print_path_info("Greedy1", g1)
    print_path_info("Greedy1 + Local (best)", best1)
    print_path_info("Greedy2", g2)
    print_path_info("Greedy2 + Local (best)", best2)
